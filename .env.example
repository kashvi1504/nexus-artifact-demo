# Copy this file to .env for MANUAL runs (scripts/local-pipeline.sh).
#   cp .env.example .env
# .env is listed in .gitignore and must NEVER be committed.
# Jenkins does NOT use this file - it uses the Jenkins credential "nexus-credentials".

NEXUS_URL=http://localhost:8081
NEXUS_REPO=devops-artifacts
NEXUS_USER=jenkins-ci
# Keep the single quotes if the password contains special characters like $ " ! or spaces
NEXUS_PASSWORD='change-me'
APP_PORT=3000
